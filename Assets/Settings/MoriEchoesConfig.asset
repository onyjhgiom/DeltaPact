    bossTechniques:
    - name: "\u94F8\u6D41\u5206\u95F8"
      release: "\u4E24\u9053\u7A84\u7194\u6D41\u4EA4\u66FF\u5F00\u542F\uFF0C\u4E2D\u592E\u51B7\u5374\u5E26\u59CB\u7EC8\u53EF\u901A\u884C\u3002"
      visual: "\u94F8\u94C1\u95F8\u5634\u55B7\u51FA\u9ECF\u7A20\u7194\u6D46\uFF0C\u6697\u8272\u6C27\u5316\u58F3\u5305\u4F4F\u6A59\u7EA2\u5185\u6838\u3002"
      dodge: "\u8FDB\u5165\u4E2D\u592E\u95F4\u9694\uFF0C\u907F\u514D\u7194\u6D41\u5E95\u5EA7\u3002"
