    bossTechniques:
    - name: "\u949F\u9CCD\u56DE\u65CB"
      release: "\u949F\u5F62\u9CCD\u6CBF\u56FA\u5B9A\u534A\u5706\u822A\u8FF9\u7ED5\u8FC7\u73A9\u5BB6\u65E7\u4F4D\u7F6E\u3002"
